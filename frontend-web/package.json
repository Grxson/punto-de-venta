{
  "name": "frontend-web",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode production",
    "build:prod": "vite build --mode production",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:prod": "vite preview --host 0.0.0.0 --port 4173",
    "start": "serve -s dist -l $PORT",
    "electron": "electron .",
    "electron:dev": "concurrently \"npm run dev\" \"sleep 3 && electron .\"",
    "electron:prod": "NODE_ENV=production electron .",
    "electron:railway": "NODE_ENV=production RAILWAY_FRONTEND_URL=https://frontend-production-ac0b.up.railway.app electron .",
    "build:electron": "npm run build:prod && electron-builder",
    "build:electron:prod": "npm run build:prod && RAILWAY_FRONTEND_URL=${RAILWAY_FRONTEND_URL:-https://frontend-production-ac0b.up.railway.app} electron-builder",
    "dist": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64",
    "dist:all": "electron-builder --win --linux --x64",
    "verify": "node verify-build.js"
  },
  "build": {
    "appId": "com.puntodeventa.app",
    "productName": "Punto de Venta",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@emotion/react": "11.11.1",
    "@emotion/styled": "11.11.0",
    "@mui/icons-material": "5.15.11",
    "@mui/material": "5.15.11",
    "@mui/x-date-pickers": "6.19.0",
    "@stomp/stompjs": "7.0.0",
    "@tanstack/react-query": "5.32.0",
    "@tanstack/react-query-devtools": "5.32.0",
    "axios": "1.6.8",
    "date-fns": "2.30.0",
    "is-glob": "^4.0.3",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hook-form": "7.48.0",
    "react-router-dom": "6.20.1",
    "recharts": "2.10.3",
    "serve": "14.2.0",
    "sockjs-client": "1.6.1",
    "web-vitals": "3.3.2"
  },
  "devDependencies": {
    "@eslint/js": "9.0.0",
    "@types/node": "20.10.6",
    "@types/react": "18.2.45",
    "@types/react-dom": "18.2.18",
    "@typescript-eslint/eslint-plugin": "6.17.0",
    "@typescript-eslint/parser": "6.17.0",
    "@vitejs/plugin-react": "4.2.1",
    "concurrently": "8.2.2",
    "electron": "27.0.0",
    "electron-builder": "24.6.4",
    "electron-is-dev": "3.0.1",
    "eslint": "8.56.0",
    "eslint-plugin-react-hooks": "4.6.0",
    "eslint-plugin-react-refresh": "0.4.5",
    "globals": "13.24.0",
    "rollup-plugin-visualizer": "5.12.0",
    "terser": "5.26.0",
    "typescript": "5.3.3",
    "visualizer": "3.1.0",
    "vite": "5.0.10",
    "vite-plugin-pwa": "0.17.5",
    "wait-on": "7.2.0",
    "workbox-cli": "7.0.0"
  }
}
